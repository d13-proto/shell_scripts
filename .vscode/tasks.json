{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "sync_windows",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/sync_windows.ps1"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "sync_linux",
            "type": "process",
            "command": "wsl",
            "args": ["--cd", "${workspaceFolder}", "--", "bash", "./sync_linux.sh"],
            "problemMatcher": []
        }
    ]
}
